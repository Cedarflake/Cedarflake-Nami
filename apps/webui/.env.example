# [EN] Required by the default PostgreSQL-backed instance.
# [CN] 默认使用 PostgreSQL 存储时必填。
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
# [EN] Required by the D1 REST adapter and bundled database initialization or schema-update commands.
# [CN] 使用 D1 REST 适配器或内置数据库初始化、Schema 更新命令时必填。
CLOUDFLARE_D1_API_TOKEN="your-d1-read-write-api-token"

# [EN] Required: GitHub OAuth and one shared instance secret.
# [CN] 必填：GitHub OAuth 与一个共享实例密钥。
GITHUB_CLIENT_ID="your-client-id"
GITHUB_CLIENT_SECRET="your-client-secret"
# [EN] Must exactly match I0C_SECRET on every Runtime deployment.
# [CN] 必须与每个平台 Runtime 部署中的 I0C_SECRET 完全一致。
I0C_SECRET="replace-with-a-32-byte-random-secret"

# [EN] Optional compatibility override when the deployment URL cannot be inferred.
# [CN] 可选兼容项：仅在部署地址无法自动推断时设置。
# NEXTAUTH_URL="http://localhost:3000"
